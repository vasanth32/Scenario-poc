@host = http://localhost:5102

# @name customerLogin
POST {{host}}/api/auth/token
Content-Type: application/json

{ "userName": "local-customer", "role": "Customer" }

###
# @name adjusterLogin
POST {{host}}/api/auth/token
Content-Type: application/json

{ "userName": "local-adjuster", "role": "Adjuster" }

@customerToken = {{customerLogin.response.body.$.accessToken}}
@adjusterToken = {{adjusterLogin.response.body.$.accessToken}}

### 200 - existing policy
GET {{host}}/api/policies/11111111-1111-1111-1111-111111111111
Accept: application/json
Authorization: Bearer {{customerToken}}

### 200 - existing (inactive) policy
GET {{host}}/api/policies/22222222-2222-2222-2222-222222222222
Authorization: Bearer {{customerToken}}

### 404 - well-formed id that does not exist
GET {{host}}/api/policies/99999999-9999-9999-9999-999999999999
Authorization: Bearer {{customerToken}}

### 400 - id is not a GUID
GET {{host}}/api/policies/not-a-guid
Authorization: Bearer {{customerToken}}

### 400 - empty GUID
GET {{host}}/api/policies/00000000-0000-0000-0000-000000000000
Authorization: Bearer {{customerToken}}

### 200 - list policies
GET {{host}}/api/policies
Authorization: Bearer {{customerToken}}

### 201 - create policy
POST {{host}}/api/policies
Content-Type: application/json
Authorization: Bearer {{adjusterToken}}

{
  "policyNumber": "POL-2001",
  "holderName": "Jane Doe",
  "coverageAmount": 5000,
  "startDate": "2026-01-01",
  "endDate": "2027-01-01"
}

### 409 - duplicate policy number
POST {{host}}/api/policies
Content-Type: application/json
Authorization: Bearer {{adjusterToken}}

{
  "policyNumber": "POL-1001",
  "holderName": "Jane Doe",
  "coverageAmount": 5000,
  "startDate": "2026-01-01",
  "endDate": "2027-01-01"
}

### 400 - EndDate before StartDate, empty holder, bad coverage
POST {{host}}/api/policies
Content-Type: application/json
Authorization: Bearer {{adjusterToken}}

{
  "policyNumber": "POL-2002",
  "holderName": "",
  "coverageAmount": 0,
  "startDate": "2027-01-01",
  "endDate": "2026-01-01"
}

### 200 - update policy
PUT {{host}}/api/policies/22222222-2222-2222-2222-222222222222
Content-Type: application/json
Authorization: Bearer {{adjusterToken}}

{
  "policyNumber": "POL-1002",
  "holderName": "Updated Holder",
  "coverageAmount": 7000,
  "startDate": "2026-01-01",
  "endDate": "2027-01-01",
  "isActive": true
}

### 404 - update unknown policy
PUT {{host}}/api/policies/99999999-9999-9999-9999-999999999999
Content-Type: application/json
Authorization: Bearer {{adjusterToken}}

{
  "policyNumber": "POL-3000",
  "holderName": "X",
  "coverageAmount": 10,
  "startDate": "2026-01-01",
  "endDate": "2027-01-01",
  "isActive": true
}

### 404 - delete unknown policy
DELETE {{host}}/api/policies/99999999-9999-9999-9999-999999999999
Authorization: Bearer {{adjusterToken}}

### 400 - delete with bad id
DELETE {{host}}/api/policies/not-a-guid
Authorization: Bearer {{adjusterToken}}


### Chaos toggle (Development only) - show current settings
GET {{host}}/api/chaos
Authorization: Bearer {{adjusterToken}}

### Add 3 s latency to every policy call (Claims' attempt timeout is 2 s)
PUT {{host}}/api/chaos
Content-Type: application/json
Authorization: Bearer {{adjusterToken}}

{ "latencyMs": 3000 }

### Return random HTTP 500s for 50% of calls
PUT {{host}}/api/chaos
Content-Type: application/json
Authorization: Bearer {{adjusterToken}}

{ "failureRate": 0.5 }

### Simulate downtime (503 for every policy call)
PUT {{host}}/api/chaos
Content-Type: application/json
Authorization: Bearer {{adjusterToken}}

{ "down": true }

### 400 - failureRate out of range
PUT {{host}}/api/chaos
Content-Type: application/json
Authorization: Bearer {{adjusterToken}}

{ "failureRate": 2 }

### Turn all chaos off
DELETE {{host}}/api/chaos
Authorization: Bearer {{adjusterToken}}
