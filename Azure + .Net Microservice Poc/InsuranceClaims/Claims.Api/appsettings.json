{
   "ConnectionStrings": {
    "ClaimsDb": ""
  },
  "Jwt": {
    "Issuer": "InsuranceClaims.Local",
    "Audience": "InsuranceClaims.Api",
    "ExpiryMinutes": 60
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "PolicyApi": {
    "BaseUrl": "http://localhost:5102/",
    "Resilience": {
      "TotalTimeoutSeconds": 10,
      "AttemptTimeoutSeconds": 2,
      "MaxRetryAttempts": 2,
      "RetryBaseDelayMs": 200,
      "CircuitFailureRatio": 0.5,
      "CircuitMinimumThroughput": 10,
      "CircuitSamplingSeconds": 30,
      "CircuitBreakDurationSeconds": 15
    }
  },
  "AllowedHosts": "*"
}
